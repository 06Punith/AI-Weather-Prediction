# ==============================================================================
# Aether AI Weather Prediction System — Environment Configuration
# ==============================================================================

PROJECT_NAME="Aether AI Weather Prediction System"
VERSION="1.0.0"
ENV="development"
DEBUG=True

# Network and Server
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# Frontend Integration CORS Allowed Origins (comma separated)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://192.168.1.4:5173"

# Database Configuration (MongoDB or fallback)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="weather_prediction"

# Meteorological Data Providers & High-Accuracy Calibration
# Options: "weatherapi" (for 100% exact Google Weather / METAR sync), "open-meteo" (free, no key), "openweathermap"
WEATHER_API_PROVIDER="open-meteo"
WEATHER_API_KEY="" # Paste your free key from weatherapi.com (1M requests/mo free) or openweathermap.org

# Open-Meteo Integration
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OPEN_METEO_ARCHIVE_URL="https://archive-api.open-meteo.com/v1"
OPEN_METEO_GEOCODING_URL="https://geocoding-api.open-meteo.com/v1"
OPEN_METEO_TIMEOUT_SECONDS=15.0

# Automated Background Jobs
SCHEDULER_ENABLED=True

# Security
ADMIN_API_KEY="aether-admin-secret-key-change-in-prod"
